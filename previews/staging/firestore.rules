rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/localRooms/$(roomId);
    }

    function playerPath(roomId, uid) {
      return /databases/$(database)/documents/localRooms/$(roomId)/players/$(uid);
    }

    function isRoomHost(roomId) {
      return signedIn()
        && get(roomPath(roomId)).data.hostUid == request.auth.uid;
    }

    function isRoomMember(roomId) {
      return signedIn()
        && exists(playerPath(roomId, request.auth.uid))
        && get(playerPath(roomId, request.auth.uid)).data.active == true;
    }

    function validLegacyRoomExpiryMigration() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return signedIn()
        && changed.hasOnly(['expiresAt'])
        && !('expiresAt' in resource.data)
        && resource.data.hostUid == request.auth.uid
        && resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt
          <= resource.data.createdAt + duration.value(24, 'h');
    }

    function validRoomCreate() {
      return signedIn()
        && request.resource.data.keys().hasAll([
          'name', 'visibility', 'gameType', 'durationMinutes', 'roundsTotal',
          'maxPlayers', 'playerCount', 'hostUid', 'status', 'round',
          'bookId', 'verseId', 'usedBookIds', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'visibility', 'gameType', 'durationMinutes', 'roundsTotal',
          'maxPlayers', 'playerCount', 'hostUid', 'status', 'round',
          'bookId', 'verseId', 'usedBookIds', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 48
        && request.resource.data.visibility in ['link', 'public']
        && request.resource.data.gameType in ['timed', 'rounds']
        && request.resource.data.maxPlayers == 200
        && request.resource.data.playerCount == 1
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.round == 0
        && request.resource.data.bookId == null
        && request.resource.data.verseId == null
        && request.resource.data.usedBookIds is list
        && request.resource.data.usedBookIds.size() == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt
          <= request.time + duration.value(24, 'h')
        && (request.resource.data.gameType == 'timed'
          ? request.resource.data.durationMinutes is int
            && request.resource.data.durationMinutes >= 1
            && request.resource.data.durationMinutes <= 240
            && request.resource.data.roundsTotal == null
          : request.resource.data.durationMinutes == null
            && request.resource.data.roundsTotal is int
            && request.resource.data.roundsTotal >= 1
            && request.resource.data.roundsTotal <= 1000);
    }

    function validRoomGameUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let legacyExpiryMigration =
        !('expiresAt' in resource.data)
        && resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt
          <= resource.data.createdAt + duration.value(24, 'h');

      let startedGame =
        resource.data.status == 'lobby'
        && request.resource.data.status == 'playing'
        && changed.hasOnly(['status', 'startedAt', 'deadlineAt', 'expiresAt'])
        && (legacyExpiryMigration
          || ('expiresAt' in resource.data
            && resource.data.expiresAt > request.time
            && request.resource.data.expiresAt == resource.data.expiresAt))
        && (resource.data.gameType == 'timed'
          ? request.resource.data.startedAt is int
            && request.resource.data.deadlineAt is int
            && request.resource.data.startedAt <= request.time.toMillis()
            && request.resource.data.deadlineAt > request.time.toMillis()
            && request.resource.data.deadlineAt
              == request.resource.data.startedAt
                + resource.data.durationMinutes * 60 * 1000
          : !changed.hasAny(['startedAt', 'deadlineAt']));

      let finishedGame =
        resource.data.status == 'playing'
        && request.resource.data.status == 'finished'
        && ('expiresAt' in resource.data)
        && resource.data.expiresAt > request.time
        && changed.hasOnly(['status', 'finishedAt', 'expiresAt'])
        && request.resource.data.finishedAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.finishedAt == request.time
        && request.resource.data.expiresAt == request.time;

      return signedIn()
        && resource.data.hostUid == request.auth.uid
        && (startedGame || finishedGame);
    }

    function validRoomPlayerCountUpdate(roomId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let member = playerPath(roomId, request.auth.uid);
      let legacyExpiryMigration =
        !('expiresAt' in resource.data)
        && resource.data.hostUid == request.auth.uid
        && resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt
          <= resource.data.createdAt + duration.value(24, 'h');

      let addedMember =
        (!exists(member) || get(member).data.active == false)
        && existsAfter(member)
        && getAfter(member).data.active == true
        && resource.data.status in ['lobby', 'playing']
        && (legacyExpiryMigration
          || ('expiresAt' in resource.data
            && resource.data.expiresAt > request.time
            && request.resource.data.expiresAt == resource.data.expiresAt));

      let removedMember =
        exists(member)
        && get(member).data.active == true
        && existsAfter(member)
        && getAfter(member).data.active == false;

      return signedIn()
        && changed.hasOnly(['playerCount', 'expiresAt'])
        && (addedMember
          ? request.resource.data.playerCount == resource.data.playerCount + 1
            && request.resource.data.playerCount <= resource.data.maxPlayers
          : removedMember
            && changed.hasOnly(['playerCount'])
            && request.resource.data.playerCount == resource.data.playerCount - 1
            && request.resource.data.playerCount >= 0);
    }

    function validPlayer(data) {
      let canonicalBooks = [
        'genesis', 'exodus', 'leviticus', 'numbers', 'deuteronomy', 'joshua',
        'judges', 'ruth', '1-samuel', '2-samuel', '1-kings', '2-kings',
        '1-chronicles', '2-chronicles', 'ezra', 'nehemiah', 'tobit', 'judith',
        'esther', '1-maccabees', '2-maccabees', 'job', 'psalms', 'proverbs',
        'ecclesiastes', 'song-of-solomon', 'wisdom', 'sirach', 'isaiah',
        'jeremiah', 'lamentations', 'baruch', 'ezekiel', 'daniel', 'hosea',
        'joel', 'amos', 'obadiah', 'jonah', 'micah', 'nahum', 'habakkuk',
        'zephaniah', 'haggai', 'zechariah', 'malachi', 'matthew', 'mark',
        'luke', 'john', 'acts', 'romans', '1-corinthians', '2-corinthians',
        'galatians', 'ephesians', 'philippians', 'colossians',
        '1-thessalonians', '2-thessalonians', '1-timothy', '2-timothy',
        'titus', 'philemon', 'hebrews', 'james', '1-peter', '2-peter',
        '1-john', '2-john', '3-john', 'jude', 'revelation'
      ];

      return data.keys().hasAll([
          'uid', 'name', 'score', 'lastRoundScore', 'guesses',
          'activeRound', 'currentBookId', 'currentVerseId', 'usedBookIds',
          'roundCompleted', 'gameCompleted', 'active', 'lastCorrect',
          'joinedAt', 'expiresAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'score', 'lastRoundScore', 'guesses',
          'activeRound', 'currentBookId', 'currentVerseId', 'usedBookIds',
          'roundCompleted', 'gameCompleted', 'active', 'lastCorrect',
          'joinedAt', 'expiresAt'
        ])
        && data.uid == request.auth.uid
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 32
        && data.score is int
        && data.score >= 0
        && data.lastRoundScore is int
        && data.lastRoundScore >= 0
        && data.lastRoundScore <= 10
        && data.guesses is int
        && data.guesses >= 0
        && data.guesses <= 10
        && data.activeRound is int
        && data.activeRound >= 0
        && (data.currentBookId == null
          || data.currentBookId is string
            && data.currentBookId in canonicalBooks)
        && (data.currentVerseId == null
          || data.currentVerseId is string
            && data.currentVerseId.size() > 0
            && data.currentVerseId.size() <= 80)
        && data.usedBookIds is list
        && data.usedBookIds.size() <= 73
        && data.usedBookIds.hasOnly(canonicalBooks)
        && (data.activeRound == 0
          ? data.currentBookId == null && data.currentVerseId == null
            && data.usedBookIds.size() == 0
          : data.currentBookId is string
            && data.currentVerseId is string
            && data.currentBookId in data.usedBookIds)
        && data.roundCompleted is bool
        && data.gameCompleted is bool
        && data.active is bool
        && data.lastCorrect is bool
        && data.joinedAt is timestamp
        && data.expiresAt is timestamp;
    }

    function validPlayerCreate(roomId, uid) {
      let room = getAfter(roomPath(roomId));

      return signedIn()
        && uid == request.auth.uid
        && room.data.hostUid == request.auth.uid
        && room.data.playerCount == 1
        && room.data.status == 'lobby'
        && validPlayer(request.resource.data)
        && request.resource.data.score == 0
        && request.resource.data.lastRoundScore == 0
        && request.resource.data.guesses == 0
        && request.resource.data.activeRound == 0
        && request.resource.data.currentBookId == null
        && request.resource.data.currentVerseId == null
        && request.resource.data.usedBookIds.size() == 0
        && request.resource.data.roundCompleted == false
        && request.resource.data.gameCompleted == false
        && request.resource.data.active == true
        && request.resource.data.lastCorrect == false
        && request.resource.data.expiresAt == room.data.expiresAt;
    }

    function validPlayerJoin(roomId, uid) {
      let roomBefore = get(roomPath(roomId)).data;
      let roomAfter = getAfter(roomPath(roomId)).data;

      return signedIn()
        && uid == request.auth.uid
        && roomBefore.status in ['lobby', 'playing']
        && roomBefore.expiresAt > request.time
        && roomAfter.playerCount == roomBefore.playerCount + 1
        && roomAfter.playerCount <= roomAfter.maxPlayers
        && roomAfter.status == roomBefore.status
        && roomAfter.expiresAt == roomBefore.expiresAt
        && validPlayer(request.resource.data)
        && request.resource.data.score == 0
        && request.resource.data.lastRoundScore == 0
        && request.resource.data.guesses == 0
        && request.resource.data.activeRound == 0
        && request.resource.data.currentBookId == null
        && request.resource.data.currentVerseId == null
        && request.resource.data.usedBookIds.size() == 0
        && request.resource.data.roundCompleted == false
        && request.resource.data.gameCompleted == false
        && request.resource.data.active == true
        && request.resource.data.lastCorrect == false
        && request.resource.data.expiresAt == roomAfter.expiresAt;
    }

    function validPlayerRoundStart(room, changed) {
      let priorUsedBooks = resource.data.get(
        'usedBookIds',
        resource.data.activeRound > 0 ? room.usedBookIds : []
      );
      let changedBooks =
        priorUsedBooks.size() < 73
          ? !(request.resource.data.currentBookId in priorUsedBooks)
            && request.resource.data.usedBookIds.size()
              == priorUsedBooks.size() + 1
            && request.resource.data.usedBookIds.hasAll(
              priorUsedBooks)
          : priorUsedBooks.size() == 73
            && request.resource.data.usedBookIds.size() == 73;

      let validRoundStart =
        (resource.data.activeRound == 0
          && request.resource.data.activeRound == 1
          && !resource.data.roundCompleted)
        || (resource.data.activeRound > 0
          && resource.data.roundCompleted
          && !resource.data.get('gameCompleted', false)
          && request.resource.data.activeRound == resource.data.activeRound + 1);

      return
        room.status == 'playing'
        && room.expiresAt > request.time
        && resource.data.active
        && !resource.data.get('gameCompleted', false)
        && validRoundStart
        && (room.gameType != 'rounds'
          || request.resource.data.activeRound <= room.roundsTotal)
        && (!('deadlineAt' in room)
          || request.time.toMillis() <= room.deadlineAt)
        && request.resource.data.score == resource.data.score
        && request.resource.data.guesses == 0
        && request.resource.data.roundCompleted == false
        && request.resource.data.gameCompleted == false
        && request.resource.data.lastRoundScore == 0
        && request.resource.data.lastCorrect == false
        && request.resource.data.currentBookId is string
        && request.resource.data.currentVerseId is string
        && request.resource.data.currentBookId
          in request.resource.data.usedBookIds
        && (priorUsedBooks.size() == 0
          ? request.resource.data.usedBookIds.size() == 1
          : changedBooks)
        && request.resource.data.active == resource.data.active
        && request.resource.data.expiresAt == room.expiresAt
        && changed.hasOnly([
          'currentBookId', 'currentVerseId', 'usedBookIds', 'activeRound',
          'guesses', 'roundCompleted', 'gameCompleted', 'lastRoundScore',
          'lastCorrect', 'expiresAt'
        ]);
    }

    function validLegacyPlayerRoundMigration(room, changed) {
      return room.status == 'playing'
        && room.round >= 1
        && room.round == resource.data.activeRound
        && resource.data.get('currentVerseId', null) == null
        && resource.data.get('currentBookId', null) == null
        && room.bookId is string
        && room.verseId is string
        && room.usedBookIds is list
        && !resource.data.roundCompleted
        && request.resource.data.currentBookId == room.bookId
        && request.resource.data.currentVerseId == room.verseId
        && request.resource.data.usedBookIds == room.usedBookIds
        && request.resource.data.gameCompleted == false
        && request.resource.data.score == resource.data.score
        && request.resource.data.guesses == resource.data.guesses
        && request.resource.data.lastRoundScore == resource.data.lastRoundScore
        && request.resource.data.lastCorrect == resource.data.lastCorrect
        && request.resource.data.active == resource.data.active
        && request.resource.data.expiresAt == room.expiresAt
        && changed.hasOnly([
          'currentBookId', 'currentVerseId', 'usedBookIds', 'gameCompleted'
        ]);
    }

    function validPlayerRoundCompletion(room, changed) {
      let earned = request.resource.data.lastCorrect
        ? 11 - request.resource.data.guesses
        : 0;

      return
        !resource.data.roundCompleted
        && request.resource.data.roundCompleted
        && !resource.data.gameCompleted
        && room.status == 'playing'
        && room.expiresAt > request.time
        && request.resource.data.activeRound == resource.data.activeRound
        && request.resource.data.guesses > resource.data.guesses
        && request.resource.data.guesses <= 10
        && request.resource.data.score == resource.data.score + earned
        && request.resource.data.lastRoundScore == earned
        && request.resource.data.gameCompleted
          == (room.gameType == 'rounds'
            && request.resource.data.activeRound >= room.roundsTotal)
        && request.resource.data.currentBookId == resource.data.currentBookId
        && request.resource.data.currentVerseId == resource.data.currentVerseId
        && request.resource.data.usedBookIds == resource.data.usedBookIds
        && request.resource.data.active == resource.data.active
        && request.resource.data.expiresAt == room.expiresAt
        && changed.hasOnly([
          'guesses', 'roundCompleted', 'lastRoundScore', 'lastCorrect',
          'score', 'gameCompleted', 'expiresAt'
        ])
        && (!('deadlineAt' in room)
          || request.time.toMillis() <= room.deadlineAt);
    }

    function validPlayerGuessProgress(room, changed) {
      return
        room.status == 'playing'
        && room.expiresAt > request.time
        && resource.data.active
        && !resource.data.roundCompleted
        && !resource.data.gameCompleted
        && request.resource.data.activeRound == resource.data.activeRound
        && request.resource.data.roundCompleted == false
        && request.resource.data.guesses >= resource.data.guesses
        && request.resource.data.guesses <= 10
        && request.resource.data.score == resource.data.score
        && request.resource.data.lastRoundScore == 0
        && request.resource.data.lastCorrect == false
        && request.resource.data.gameCompleted == false
        && request.resource.data.currentBookId == resource.data.currentBookId
        && request.resource.data.currentVerseId == resource.data.currentVerseId
        && request.resource.data.usedBookIds == resource.data.usedBookIds
        && request.resource.data.active == resource.data.active
        && request.resource.data.expiresAt == room.expiresAt
        && changed.hasOnly([
          'guesses', 'roundCompleted', 'lastRoundScore', 'lastCorrect',
          'score', 'expiresAt'
        ]);
    }

    function validPlayerRejoin(room, roomAfter, changed) {
      return
        !resource.data.active
        && request.resource.data.active
        && room.status in ['lobby', 'playing']
        && (!('expiresAt' in room)
          ? room.hostUid == request.auth.uid
          : room.expiresAt > request.time)
        && roomAfter.playerCount == room.playerCount + 1
        && roomAfter.expiresAt is timestamp
        && roomAfter.expiresAt > request.time
        && (('expiresAt' in room)
          ? roomAfter.expiresAt == room.expiresAt
          : roomAfter.expiresAt
            <= room.createdAt + duration.value(24, 'h'))
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.score == resource.data.score
        && request.resource.data.expiresAt == roomAfter.expiresAt
        && changed.hasOnly(['active', 'expiresAt']);
    }

    function validPlayerUpdate(roomId, uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let room = get(roomPath(roomId)).data;
      let roomAfter = getAfter(roomPath(roomId)).data;
      let rename =
        changed.hasOnly(['name'])
        && room.status in ['lobby', 'playing']
        && room.expiresAt > request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 32;
      let leaving =
        resource.data.active
        && !request.resource.data.active
        && changed.hasOnly(['active'])
        && request.resource.data.score == resource.data.score
        && roomAfter.playerCount == room.playerCount - 1;
      let validUpdate = changed.hasAny([
          'currentBookId', 'currentVerseId', 'usedBookIds'
        ])
          ? validLegacyPlayerRoundMigration(room, changed)
            || validPlayerRoundStart(room, changed)
          : changed.hasAny(['roundCompleted', 'score', 'gameCompleted'])
            ? validPlayerRoundCompletion(room, changed)
            : changed.hasAny(['guesses'])
              ? validPlayerGuessProgress(room, changed)
              : rename || validPlayerRejoin(room, roomAfter, changed) || leaving;

      return signedIn()
        && uid == request.auth.uid
        && validPlayer(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && validUpdate;
    }

    function dailyScorePath(dateKey, uid) {
      return /databases/$(database)/documents/dailyStats/$(dateKey)/scores/$(uid);
    }

    function validDailyScore(uid) {
      return signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'result', 'guesses', 'completedAt', 'puzzleId'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'result', 'guesses', 'completedAt', 'puzzleId'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.result in ['won', 'lost']
        && request.resource.data.puzzleId is string
        && request.resource.data.puzzleId.size() > 0
        && (request.resource.data.result == 'won'
          ? request.resource.data.guesses is int
            && request.resource.data.guesses >= 1
            && request.resource.data.guesses <= 8
          : request.resource.data.guesses == null)
        && request.resource.data.completedAt is timestamp;
    }

    function validDailyStats(dateKey, creating) {
      let scorePath = dailyScorePath(dateKey, request.auth.uid);
      let score = getAfter(scorePath).data;

      let oldPlayers = creating ? 0 : resource.data.players;
      let oldSolvers = creating ? 0 : resource.data.solvers;
      let oldTotal = creating ? 0 : resource.data.totalWinningGuesses;

      return signedIn()
        && existsAfter(scorePath)
        && score.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'date', 'puzzleId', 'players', 'solvers',
          'totalWinningGuesses', 'averageWinningGuesses', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'date', 'puzzleId', 'players', 'solvers',
          'totalWinningGuesses', 'averageWinningGuesses', 'updatedAt'
        ])
        && request.resource.data.date == dateKey
        && request.resource.data.puzzleId == score.puzzleId
        && request.resource.data.players == oldPlayers + 1
        && request.resource.data.solvers == oldSolvers
          + (score.result == 'won' ? 1 : 0)
        && request.resource.data.totalWinningGuesses == oldTotal
          + (score.result == 'won' ? score.guesses : 0)
        && request.resource.data.averageWinningGuesses
          == (request.resource.data.solvers > 0
            ? request.resource.data.totalWinningGuesses
              / request.resource.data.solvers
            : 0)
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{uid}/profile/main {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /dailyStats/{dateKey} {
      allow get: if true;
      allow list: if false;
      allow create: if validDailyStats(dateKey, true);
      allow update: if !exists(dailyScorePath(dateKey, request.auth.uid))
        && validDailyStats(dateKey, false);
      allow delete: if false;

      match /scores/{uid} {
        allow get, list: if true;
        allow create: if validDailyScore(uid);
        allow update, delete: if false;
      }
    }

    match /localRooms/{roomId} {
      allow get: if signedIn();
      allow list: if signedIn()
        && resource.data.visibility == 'public'
        && resource.data.status in ['lobby', 'playing'];
      allow create: if validRoomCreate();
      allow update: if validRoomGameUpdate()
        || validRoomPlayerCountUpdate(roomId)
        || validLegacyRoomExpiryMigration();
      allow delete: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && resource.data.status in ['lobby', 'finished'];

      match /players/{uid} {
        allow get: if signedIn()
          && (request.auth.uid == uid || isRoomMember(roomId));
        allow list: if isRoomMember(roomId)
          || (signedIn() && isRoomHost(roomId)
            && get(roomPath(roomId)).data.status == 'finished');
        allow create: if validPlayerCreate(roomId, uid)
          || validPlayerJoin(roomId, uid);
        allow update: if validPlayerUpdate(roomId, uid);
        allow delete: if signedIn()
          && isRoomHost(roomId)
          && get(roomPath(roomId)).data.status == 'finished';
      }
    }
  }
}